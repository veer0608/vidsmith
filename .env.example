# All optional. Narration and captions work with no keys at all.
# Free stock footage: https://www.pexels.com/api/
PEXELS_API_KEY=
# Alternative stock source: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# B-roll search queries + YouTube metadata + `new --topic` script drafting
GEMINI_API_KEY=
# Gate for an exposed instance: any tunnel or host is a renderer that spends the
# keys above. scripts/serve-public.ps1 mints one here on first run. Unset means
# no gate at all, which is only right on localhost.
VIDSMITH_TOKEN=
