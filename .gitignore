.venv/
.scratch/
__pycache__/
*.pyc
# .env* so a stray .env.local or .env.backup cannot be committed by accident;
# .env.example is the one that must stay tracked, since it documents the keys.
.env*
!.env.example
projects/*/build/
projects/*/out/
assets/clips/
bin/
assets/fonts/
jobs/
web/__pycache__/

# Stock-search results, cached for the day Pixabay's terms require.
.cache/

# Local agent state, including git worktrees. 2.6 MB of checkouts of this same
# repo, so committing it would nest the repository inside itself.
.claude/

# Launch drafts. Local working notes, deliberately not published: the posts
# should be read where they are posted, not found in the repo beforehand.
docs/launch-*.md
